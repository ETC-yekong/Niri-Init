{
	//----------电源按钮模块配置----------
    "custom/power": {
        "format": "",
        "tooltip-format": "左键显示电源菜单\n右键打开启动器",
		"on-click": "~/.config/waybar/scripts/powermenu.sh",
		"on-click-right": "fuzzel"
    },
	//----------工作区模块配置----------
	"niri/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"active": "󰜋",
			"default": ""
		}
	},
	//----------窗口模块配置----------
	"niri/window": {
		"format": "{}",
		"rewrite": {
			"(.*) - Microsoft Edge": "$1"	
		},
		"max-length": 24
	},
	//----------性能切换模块配置----------
	"power-profiles-daemon": {
		"format": "{icon}",
        "tooltip-format": "当前性能模式：{profile}\n---\n左键：切换性能模式",
        "tooltip": true,
        "format-icons": {
            "performance": "󱐋",
            "balanced": "",
            "power-saver": ""
        }
	},
	//----------自动熄屏管理配置----------
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
            "activated": "",
			"deactivated": ""
		},
		"start-activated": true,
		"tooltip-format-activated": "自动熄屏已禁止",
		"tooltip-format-deactivated": "自动熄屏已开启"
	},
	//----------时钟模块配置----------
	"clock": {
		"format": "󰥔 {:%H:%M %m月%d日 %a}",
		"interval": 60,
		"calendar":{
			"format": {
				"months":   "<span color='#dcc66e'><b>{}</b></span>",   //月份标题样式（金色加粗）
				"days":     "<span color='#c8c8c8'>{}</span>",         //普通日期样式（浅灰）
				"today":    "<span color='#ffb4ab' weight='700'><u>{}</u></span>", //今天的日期样式（粉色加粗下划线）
				"weekdays": "<span color='#d2c6a1'><b>{}</b></span>",  //星期标题样式（米色加粗）
				"weeks":    "<span color='#aad0b2'><b>W{}</b></span>"  //周数样式（绿色，显示如 W34）
			},
			"mode": "month",      //日历显示模式：month=只显示当月，year=显示全年
			"mode-mon-col": 1,    //年视图下每行显示几个月（月视图下无影响）
			"on-scroll": 1        //在日历上滚动鼠标时切换上/下一个月
		},
		//<tt>强制等宽字体，保证星期与日期列对齐（修复错位的关键）
		"tooltip-format": "<tt>{calendar}</tt>\n---\n左键：时钟（gnome clocks）\n右键：日历（gnome-calendar)",
		"on-click": "gnome-clocks",
		"on-click-right": "gnome-calendar"
	},
	//------------媒体播放器模块配置------------
	"group/mediaplayer": {
		"orientation": "horizontal",
		"modules": [
			"custom/media-prev",
			"custom/media-playpause",
			"custom/media-next"
		]
	},
	"custom/media-prev": {
        "format": "󰒮",
		"tooltip-format": "上一首",
		"on-click": "playerctl previous",
		"interval": 30
	},
	"custom/media-playpause": {
		"exec": "~/.config/waybar/scripts/media-playpause.sh", //脚本输出状态图标（播放中显示暂停图标）
		"on-click": "playerctl play-pause", //点击切换播放/暂停
		"tooltip-format": "点击：播放/暂停",
		"interval": 5 //每隔5秒刷新一次图标，跟随状态变化
	},
	"custom/media-next": {
		"format": "󰒭",
		"tooltip-format": "下一首",
		"on-click": "playerctl next",
		"interval": 30
	},
	//----------托盘模块配置----------
	"tray": {
		"icon-size": 14,
		"spacing": 4,
		//只显示活动/需要关注的图标，其余后台图标折叠进托盘箭头，防止右侧过宽把中间时钟顶开
		"show-passive-items": false
	},
	//----------音频模块配置------------
//音量 + 麦克风 + 滑块，鼠标悬停在 group 上时展开显示
	"group/audio": {
		"orientation": "inherit",  //滑块方向跟随 waybar 排列方向（横向）
		"drawer": {
			"transition-left-to-right": false
		},
		"modules": [
			"custom/audio",   //扬声器：音量图标 + 百分比
			"custom/mic",     //麦克风：状态 + 百分比
			"pulseaudio/slider" //滑块：支持鼠标拖拽调节音量
		]
	},
	"custom/audio": {
		"exec": "~/.config/waybar/scripts/audio-sink.sh", //输出音量图标/百分比/静音状态
		"interval": 2,  //每2秒刷新
		"signal": 10,  //收到 RTMIN+10 信号时立即刷新（Niri 音量键触发）
		"return-type": "json",  //脚本输出 JSON 格式（含 text/tooltip/class）
		"format": "{}",
		"on-click": "pavucontrol",  //左键打开音频控制面板
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",  //右键静音/取消静音
		"on-scroll-up": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume --limit 1.53 @DEFAULT_AUDIO_SINK@ 5%+",  //滚轮向上：音量+5%
		"on-scroll-down": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume --limit 1.53 @DEFAULT_AUDIO_SINK@ 5%-"  //滚轮向下：音量-5%
	},
	"custom/mic": {
		"exec": "~/.config/waybar/scripts/mic.sh",  //输出麦克风状态/音量
		"signal": 11,  //收到 RTMIN+11 信号时立即刷新（Niri 麦克风静音键触发）
		"tooltip-format": "麦克风\n---\n左键：静音切换\n滚动：调节麦克风音量",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",  //左键静音/取消静音
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",  //滚轮向上：麦克风音量+5%
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",  //滚轮向下：麦克风音量-5%
		"interval": 2  //每2秒刷新
	},
	"pulseaudio/slider": {
		"min": 0,
		"max": 100,  //滑块范围 0~100
		"orientation": "horizontal"  //横向滑块，可鼠标拖拽调节音量
	},
	//----------网络模块配置----------
	"network": {
		"format-disconnected": "{icon}",
		"format-wifi": "{icon}",
		"format-ethernet": "{icon}",
		"format-icons": {
			"disconnected": "󰤮",
			"wifi": [
				"󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
			],
			"ethernet": "󰈀"
		},
		"tooltip-format-disconnected": "网络未连接\n---\n左键：打开面板\n右键：高级网络配置",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\n左键：打开面板\n右键：高级网络配置",
		"tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\n左键：打开面板\n右键：高级网络配置",
		"on-click": "kitty --class network-tui -e ~/.config/waybar/scripts/select-network-tui.sh",
		"on-click-right": "kitty --class nmtui --title nmtui nmtui"
	},
	//----------蓝牙模块配置----------
	"bluetooth": {
		"format-disabled": "{icon}",
		"format-on": "{icon}",
		"format-connected": "{icon}",
		"format-icons": {
			"disabled": "󰂲",
			"on": "󰂯",
			"connected": "󰂱",
		},
		"tooltip-format-disabled": "蓝牙未启用\n---\n右键：启用蓝牙",
		"tooltip-format-on": "蓝牙未连接\n---\n左键：打开面板（bluetui）\n右键：禁用蓝牙",
		"tooltip-format-connected": "󰂱 {device_alias}\n---\n左键：打开面板\n右键：禁用蓝牙",
		"on-click": "kitty --class bluetui -e bluetui",
		"on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh"
	},
	//----------系统硬件监测模块配置----------
	"group/system": {
		"orientation": "horizontal",
		"drawer": {
			"transition-left-to-right": false
		},
		"modules": [
			"cpu",
			"memory",
			"temperature"
		]
	},
	"cpu": {
        "format": "{usage}% ",
		"tooltip": false
	},
	"memory": {
		"format": "{}% "
	},
	"temperature": {
		"format": "{temperatureC}°C ",
		"critical-threshold": 75,
		"format-critical": ""
	},
	//----------亮度模块配置----------
	"group/backlight": {
		"orientation": "inherit",
		"drawer": {
			"transition-left-to-right": false
		},
		"modules": [
			"backlight",
			"backlight/slider"
		]
	},
	"backlight": {
		"format": "{percent}% ",  //显示亮度百分比 + 太阳图标
		"signal": 12,  //收到 RTMIN+12 信号时立即刷新（Niri 亮度键触发）
		"on-click-right": "brightnessctl -d intel_backlight set 10%-",  //右键：亮度-10%
		"on-scroll-up": "brightnessctl -d intel_backlight set 5%+",  //滚轮向上：亮度+5%
		"on-scroll-down": "brightnessctl -d intel_backlight set 5%-"  //滚轮向下：亮度-5%
	},
	"backlight/slider": {
		"min": 0,
		"max": 100,  //滑块范围 0~100
		"orientation": "horizontal",  //横向滑块，可拖拽调节亮度
		"device": "intel_backlight"  //控制笔记本内屏背光
	},
	//----------电池模块配置----------
	"battery": {
		"interval": 60,
		"states": {
			"critical": 20,
			"warning": 50
		},
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-icons": [
			"󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂂",
            "󰁹"
		],
		"tooltip-format": "剩余电量：{capacity}%\n电池功率：{power}\n可用时间：{timeTo}\n---\n电池健康度：{health}%"
	}
}
