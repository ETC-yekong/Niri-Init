#mako核心逻辑配置
#通知内容按时间排序，最新通知在上
sort=-time
#通知内容显示在屏幕最上层
layer=overlay
#默认通知显示时间（单位：ms）
default-timeout=5000
#忽略通知发送方的通知显示时间（重要喵）
ignore-timeout=1

#mako外观设置
#背景底色：灰蓝半透
background-color=#1e222a80
#边框颜色：橙色
border-color=#d08770
#边框宽度（单位：像素）
border-size=3
#边框圆角弧度
border-radius=15
#通知框宽度（单位：像素）
width=300
#通知框高度（单位：像素）
height=110
#通知是否显示图标（1为启用，0为禁用）
icons=1
#通知图标大小（单位：像素）
max-icon-size=64
#字体设置
font=monospace 14

#上述配置为通用默认配置，所有软件都适用，没有针对软件做个性化设置
#从这儿往下的配置就是针对某些软件的单独配置了
#我配置的东西都是我自己常用的一些软件，如果有其他需求可以自己进行修改
#=============分割线=============

#QQ主题配置
[app-name=QQ]
#QQ通知显示7秒
default-timeout=7000
#QQ通知边框颜色：腾讯蓝
border-color=#0052D9

#微信主题配置
[desktop-entry=wechat-universal.desktop]
#微信通知显示7秒
default-timeout=7000
#微信通知边框颜色：微信绿
border-color=#07C160

#系统高级别紧急通知配置
[urgency=high]
#系统紧急通知一直显示，只有点击通知后才会消除
default-timeout=0
#系统紧急通知边框颜色：红色
border-color=#bf616a
